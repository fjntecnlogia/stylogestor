# ============================================================
# STYLOGESTOR — Variáveis de Produção (VPS)
# Copie para /opt/stylogestor/apps/web/.env.production.local
# e /opt/stylogestor/apps/admin/.env.production.local
# NUNCA commitar este arquivo!
# ============================================================

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL="postgresql://stylogestor:SENHA_AQUI@localhost:5432/stylogestor?schema=public"

# ── Clerk (Autenticação) ───────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_PREENCHER
CLERK_SECRET_KEY=sk_live_PREENCHER
CLERK_WEBHOOK_SECRET=whsec_PREENCHER

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastro
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── URLs ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.stylogestor.com.br
NEXT_PUBLIC_API_URL=https://api.stylogestor.com.br
BASE_DOMAIN=stylogestor.com.br
INTERNAL_API_KEY=CHAVE_INTERNA_ALEATORIA_AQUI

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_PREENCHER
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_PREENCHER
STRIPE_WEBHOOK_SECRET=whsec_PREENCHER
# Stripe Connect (pagamentos dos clientes)
STRIPE_PLATFORM_FEE_PERCENT=2

# ── Resend (Email) ─────────────────────────────────────────────
# Criar conta em resend.com → Add domain → stylogestor.com.br
RESEND_API_KEY=re_PREENCHER
RESEND_FROM_EMAIL=noreply@stylogestor.com.br
RESEND_FROM_NAME=STYLOGESTOR

# ── WhatsApp (Evolution API) ───────────────────────────────────
# Instalar Evolution API no VPS (porta 8080)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=CHAVE_EVOLUTION_AQUI
EVOLUTION_INSTANCE=stylogestor

# ── Google Analytics ───────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-WK5QTXY1ZK

# ── Node ───────────────────────────────────────────────────────
NODE_ENV=production
