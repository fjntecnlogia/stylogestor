# ============================================================
# STYLOGESTOR — Variáveis de Produção
# VPS: 82.25.65.201 | Domínio: stylogestor.com.br
# ============================================================
# ATENÇÃO: Nunca commite este arquivo com valores reais!
# Copie para .env.prod e preencha no servidor.
# ============================================================

NODE_ENV=production
DOMAIN=stylogestor.com.br

# ── Banco de dados ───────────────────────────────────────────
POSTGRES_DB=stylogestor
POSTGRES_USER=stylo
# TROQUE por uma senha forte (ex: gerada em https://passwordsgenerator.net)
POSTGRES_PASSWORD=SENHA_FORTE_AQUI_MIN_32_CHARS
DATABASE_URL=postgresql://stylo:SENHA_FORTE_AQUI_MIN_32_CHARS@postgres:5432/stylogestor

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=SENHA_REDIS_FORTE_AQUI

# ── URLs do App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.stylogestor.com.br
NEXT_PUBLIC_API_URL=https://api.stylogestor.com.br
BASE_DOMAIN=stylogestor.com.br
INTERNAL_API_KEY=CHAVE_INTERNA_ALEATORIA_64_CHARS

# ── Clerk (https://clerk.com) ────────────────────────────────
# Crie uma Application chamada "STYLOGESTOR"
# Em API Keys copie os valores abaixo:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_COLE_AQUI
CLERK_SECRET_KEY=sk_live_COLE_AQUI
CLERK_WEBHOOK_SECRET=whsec_COLE_AQUI
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastro
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Pagar.me (https://pagar.me) ──────────────────────────────
# Use modo sandbox para testes, live para produção
PAGARME_API_KEY=ak_live_COLE_AQUI
PAGARME_WEBHOOK_SECRET=COLE_AQUI

# ── Evolution API (WhatsApp) ─────────────────────────────────
EVOLUTION_API_URL=http://evolution:8080
# Gere uma chave aleatória forte
EVOLUTION_API_KEY=STYLO_EVOLUTION_KEY_TROQUE_ISSO
EVOLUTION_INSTANCE_NAME=stylogestor

# ── Resend (https://resend.com) ──────────────────────────────
# Crie conta, verifique domínio stylogestor.com.br e copie a API Key
RESEND_API_KEY=re_COLE_AQUI
EMAIL_FROM=no-reply@stylogestor.com.br

