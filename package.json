{
  "name": "stylogestor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @stylogestor/database generate",
    "db:migrate": "pnpm --filter @stylogestor/database migrate:dev",
    "db:push": "pnpm --filter @stylogestor/database db:push",
    "db:studio": "pnpm --filter @stylogestor/database studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "browser-tabs-lock",
      "bufferutil",
      "core-js",
      "prisma",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  }
}
