# ============================================================
# STYLOGESTOR — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Banco de dados
DATABASE_URL="postgresql://user:password@localhost:5432/stylogestor?schema=public"

# Clerk (Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastro
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
BASE_DOMAIN=stylogestor.com.br

# Segredo compartilhado entre Next middleware e API
# Usado em GET /tenants/by-slug/:slug (header x-internal-key).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Stripe (cobrança principal — usado no packages/api)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...      # OBRIGATÓRIO para o webhook funcionar

# Pagar.me (planejado — ainda não implementado no backend)
PAGARME_API_KEY=ak_test_...
PAGARME_WEBHOOK_SECRET=...

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=...
EVOLUTION_INSTANCE_NAME=stylogestor

# Resend (Email)
RESEND_API_KEY=re_...
EMAIL_FROM=no-reply@stylogestor.com.br

# Cloudflare R2 (Storage)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=stylogestor
R2_PUBLIC_URL=https://cdn.stylogestor.com.br

# Upstash Redis (Cache/Filas)
UPSTASH_REDIS_URL=https://...
UPSTASH_REDIS_TOKEN=...
