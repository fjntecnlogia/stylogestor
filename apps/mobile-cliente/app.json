{
  "expo": {
    "name": "Agendar — STYLOGESTOR",
    "slug": "stylogestor-cliente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stylogestor-cliente",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3A6B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.stylogestor.cliente"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3A6B"
      },
      "package": "br.com.stylogestor.cliente",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "910744fd-65f9-4c92-9e62-95eede31eba3"
      }
    }
  }
}
