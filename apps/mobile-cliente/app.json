{
  "expo": {
    "name": "Agendar — STYLOGESTOR",
    "slug": "stylogestor-cliente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stylogestor-cliente",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3A6B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.stylogestor.cliente"
    },
    "android": {
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3A6B"
      },
      "package": "br.com.stylogestor.cliente"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiUrl": "https://app.stylogestor.com.br",
      "privacyPolicyUrl": "https://stylogestor.com.br/privacidade",
      "termsOfServiceUrl": "https://stylogestor.com.br/termos",
      "eas": {
        "projectId": "910744fd-65f9-4c92-9e62-95eede31eba3"
      }
    }
  }
}
