{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "pnpm": "9.15.9",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.0",
      "pnpm": "9.15.9",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.13.0",
      "pnpm": "9.15.9",
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "internal"
      }
    }
  }
}
