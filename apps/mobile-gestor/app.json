{
  "expo": {
    "name": "STYLOGESTOR",
    "slug": "stylogestor-gestor",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stylogestor",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3A6B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.stylogestor.gestor"
    },
    "android": {
      "versionCode": 47,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3A6B"
      },
      "package": "br.com.stylogestor.gestor",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiUrl": "https://app.stylogestor.com.br",
      "nestApiUrl": "https://api.stylogestor.com.br",
      "privacyPolicyUrl": "https://stylogestor.com.br/privacidade",
      "termsOfServiceUrl": "https://stylogestor.com.br/termos",
      "eas": {
        "projectId": "596ea82b-f4e3-4784-9c34-379b90e25f13"
      }
    }
  }
}
