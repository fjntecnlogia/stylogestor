# Workspace-wide pnpm config (lido pelo pnpm install na raiz).
#
# node-linker=hoisted: layout flat (yarn-style) sem .pnpm/<hash>/.
# Necessario porque Metro createBundleReleaseJsAndAssets nao resolve
# caminhos com .pnpm/<long-hash>/node_modules/ durante export:embed.
# Sintoma sem isso: "Failed to get the SHA-1 for: .../.pnpm/.../require.js"
node-linker=hoisted

# Postinstall scripts precisam rodar (expo/metro/prisma/etc).
# Com true: o expo nao prepara arquivos nativos => bundle release quebra.
ignore-scripts=false

# Tolerancia a peer deps quebrados em deps transitivas.
legacy-peer-deps=true
